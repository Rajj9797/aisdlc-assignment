{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "task", "datetime", "snooze_minutes", "clarification_question"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["create_reminder", "reschedule", "snooze", "needs_clarification", "unsupported"]
    },
    "task": { "type": ["string", "null"] },
    "datetime": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "[+-][0-9]{2}:[0-9]{2}$"
    },
    "snooze_minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 1440 },
    "clarification_question": { "type": ["string", "null"], "minLength": 1 }
  }
}
